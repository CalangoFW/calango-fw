# .env.example — generated by calango new
# Copy to .env and fill in the values

# App
CALANGO_APP_NAME="{{ project_name }}"
CALANGO_ENV=development
CALANGO_DEBUG=true

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECURITY__SECRET_KEY=

# Database
DATABASE__URL=postgresql+asyncpg://{{ project_name }}:{{ project_name }}@localhost:5432/{{ project_name }}_dev
DATABASE__POOL_SIZE=10

# Redis
REDIS__URL=redis://localhost:6379/0

# CORS — comma-separated list of allowed origins
SECURITY__CORS_ORIGINS=http://localhost:3000
{%- if identity %}

# Identity — RS256 signing key pair. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out identity_private.pem
#   openssl rsa -in identity_private.pem -pubout -out identity_public.pem
# Paste each PEM inside double quotes, with \n for newlines.
IDENTITY__PRIVATE_KEY=
IDENTITY__PUBLIC_KEY=
IDENTITY__REDIS_URL=redis://localhost:6379/0
{%- endif %}
