settings = Settings()


@pytest_asyncio.fixture
async def db() -> AsyncIterator[AsyncSession]:
    """Isolated database session: everything, including commits, rolls back per test."""
    engine = create_async_engine(settings.database.URL, echo=False)
    async with engine.connect() as connection:
        transaction = await connection.begin()
        # Session commits become SAVEPOINTs inside the outer transaction.
        session = AsyncSession(
            bind=connection,
            expire_on_commit=False,
            join_transaction_mode="create_savepoint",
        )
        try:
            yield session
        finally:
            await session.close()
            await transaction.rollback()
    await engine.dispose()


@pytest_asyncio.fixture
async def client(db: AsyncSession) -> AsyncIterator[AsyncClient]:
    """Async HTTP client whose requests share the test's isolated db session."""
    # Imported here so test settings (e.g. signing keys) are ready first.
    from app.main import app

    async def override_session() -> AsyncIterator[AsyncSession]:
        yield db

    # Resource routers depend on get_db; framework plugins use the app's runtime.
    for dependency in (get_db, app.database.session):
        app.dependency_overrides[dependency] = override_session
    async with AsyncClient(
        transport=ASGITransport(app=app),
        base_url="http://test",
    ) as ac:
        yield ac
    app.dependency_overrides.clear()
