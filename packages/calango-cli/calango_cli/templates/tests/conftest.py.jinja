def _ensure_identity_signing_keys() -> None:
    """Give the test run an ephemeral RS256 key pair unless one is configured."""
    if os.environ.get("IDENTITY__PRIVATE_KEY"):
        return
    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    os.environ["IDENTITY__PRIVATE_KEY"] = key.private_bytes(
        serialization.Encoding.PEM,
        serialization.PrivateFormat.PKCS8,
        serialization.NoEncryption(),
    ).decode()
    os.environ["IDENTITY__PUBLIC_KEY"] = (
        key.public_key()
        .public_bytes(
            serialization.Encoding.PEM,
            serialization.PublicFormat.SubjectPublicKeyInfo,
        )
        .decode()
    )


_ensure_identity_signing_keys()
