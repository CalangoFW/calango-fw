import os
from importlib.metadata import entry_points
from logging.config import fileConfig

from alembic import context
from app.core.config import Settings
from calango_plugin_base import PluginBase, PluginMigration
from sqlalchemy import pool
from sqlalchemy.ext.asyncio import async_engine_from_config

from calango.db import Base, import_models
from calango_cli.migrations import (
    MigrationConfigurationError,
    refresh_alembic_script,
    version_locations,
)

config = context.config
settings = Settings()

if config.config_file_name is not None:
    fileConfig(config.config_file_name)

config.set_main_option("sqlalchemy.url", settings.database.URL)


def load_plugin_migrations() -> tuple[PluginMigration, ...]:
    migrations: list[PluginMigration] = []
    for entry_point in sorted(
        entry_points(group="calango.plugins"), key=lambda item: item.name
    ):
        try:
            loaded = entry_point.load()
            plugin = loaded() if callable(loaded) else loaded
            if not isinstance(plugin, PluginBase):
                raise TypeError("entry point does not implement PluginBase")
            plugin.import_models()
            contributed = plugin.migrations()
        except Exception as exc:
            raise MigrationConfigurationError(
                f"could not load migrations for plugin '{entry_point.name}'"
            ) from exc
        if not isinstance(contributed, tuple) or not all(
            isinstance(item, PluginMigration) for item in contributed
        ):
            raise MigrationConfigurationError(
                f"plugin '{entry_point.name}' returned invalid migration descriptors"
            )
        migrations.extend(contributed)
    return tuple(migrations)


plugin_locations = version_locations(load_plugin_migrations())
configured_locations = config.get_main_option("version_locations")
all_locations = (
    *configured_locations.split(os.pathsep),
    *(str(path) for path in plugin_locations),
)
config.set_main_option("version_locations", os.pathsep.join(all_locations))
refresh_alembic_script(config, context.script)

import_models("app.contexts")
target_metadata = Base.metadata


def run_migrations_offline() -> None:
    url = config.get_main_option("sqlalchemy.url")
    context.configure(url=url, target_metadata=target_metadata, literal_binds=True)
    with context.begin_transaction():
        context.run_migrations()


def do_run_migrations(connection):
    context.configure(connection=connection, target_metadata=target_metadata)
    with context.begin_transaction():
        context.run_migrations()


async def run_async_migrations() -> None:
    connectable = async_engine_from_config(
        config.get_section(config.config_ini_section, {}),
        prefix="sqlalchemy.",
        poolclass=pool.NullPool,
    )
    async with connectable.connect() as connection:
        await connection.run_sync(do_run_migrations)
    await connectable.dispose()


def run_migrations_online() -> None:
    import asyncio
    asyncio.run(run_async_migrations())


if context.is_offline_mode():
    run_migrations_offline()
else:
    run_migrations_online()
